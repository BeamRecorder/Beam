{
  "name": "@beam/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:marketing": "vite --config vite.config.ts",
    "dev:docs": "vitepress dev docs --host 127.0.0.1 --port 7001 --strictPort",
    "docs:dev": "npm run dev:docs",
    "build:marketing": "vite-ssg build -c vite.config.ts",
    "build:docs": "vitepress build docs",
    "build": "npm run build:marketing && npm run build:docs && node scripts/finalize-build.mjs",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@unhead/vue": "^2.1.2",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.1.0",
    "schema-dts": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-ssg": "^28.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
