{
  "name": "@beam/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:marketing": "vite --config vite.config.ts",
    "dev:docs": "vitepress dev docs --host 127.0.0.1 --port 7001 --strictPort",
    "docs:dev": "bun run dev:docs",
    "build:marketing": "vite-ssg build -c vite.config.ts",
    "build:docs": "vitepress build docs",
    "build": "bun run build:marketing && bun run build:docs && node scripts/finalize-build.mjs",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@unhead/vue": "^3.4.2",
    "minisearch": "^7.2.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "schema-dts": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-ssg": "^28.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
