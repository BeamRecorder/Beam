          },
          "tables": [
            {
              "headers": ["Property", "Values", "Default or behavior"],
              "rows": [
                [
                  "Mode",
                  "Auto Cursor or Manual Focus",
                  "Auto Cursor follows recorded pointer movement; Manual Focus uses a fixed point."
