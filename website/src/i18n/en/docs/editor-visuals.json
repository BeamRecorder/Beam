    {
      "slug": "editor/capabilities/zooms",
      "title": "Zooms",
      "description": "Complete reference for manual and automatic zooms, focus modes, depth, regeneration, and motion blur.",
      "lead": "Zoom blocks direct attention to a region of the recording. Add them manually on the timeline or generate suggestions from captured cursor clicks.",
      "sections": [
        {
          "title": "No zoom selected",
          "paragraphs": [
            "Generation and global motion blur remain available without a selected zoom. Select a zoom block on the timeline to edit its depth, mode, or position."
          ],
          "screenshot": {
            "path": "editor/zoom-empty.webp",
            "alt": "Beam Zoom panel without a selected zoom",
            "caption": "Automatic generation and global motion blur do not require a selected zoom.",
            "aspectRatio": "199 / 326"
          }
        },
        {
          "title": "Generate automatic zooms",
          "tables": [
            {
              "headers": ["Action", "Requirement", "Behavior"],
              "rows": [
                [
                  "Generate Auto Zooms",
                  "A recording session with cursor-click telemetry",
                  "Creates automatic zoom blocks from recorded clicks."
                ],
                [
                  "Regenerate Auto Zooms",
                  "Automatic zoom generation is available",
                  "Asks for confirmation, preserves manual zooms, and replaces automatic zooms from the current session."
                ],
                ["Unavailable state", "No session or no cursor telemetry", "Generation remains disabled."]
              ]
            }
          ]
        },
        {
          "title": "Add a manual zoom",
          "paragraphs": [
            "Click an unoccupied point on the Zoom track. A new manual zoom defaults to 1.2 seconds and is added only when at least 200 ms of timeline duration remains available."
          ],
          "notice": {
            "kind": "info",
            "title": "Occupied timeline ranges",
            "text": "Beam chooses an available duration around the click and does not overlap an existing zoom block."
          }
        },
        {
          "title": "Selected zoom",
          "screenshot": {
            "path": "editor/zoom-properties.webp",
