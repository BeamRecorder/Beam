                ["Manual target", "Canvas drag", "Drag the dashed target directly on the canvas."],
                ["Depth 1", "1.25×", "Magnification mapping."],
                ["Depth 2", "1.5×", "Default."],
                ["Depth 3", "1.8×", "Magnification mapping."],
                ["Depth 4", "2.2×", "Magnification mapping."],
                ["Depth 5", "3.5×", "Magnification mapping."],
                ["Depth 6", "5×", "Magnification mapping."],
