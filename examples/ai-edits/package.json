{
  "name": "@beam/example-ai-edits",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --base=./",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/clock.test.ts tests/timeline.test.ts tests/publish.test.ts --coverage",
    "verify:frames": "node scripts/verify-frames.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "audio": "python scripts/score.py",
    "publish": "bun scripts/publish.ts",
    "render": "node scripts/render.mjs",
    "export": "bun scripts/publish.ts --export"
  },
  "dependencies": { "gsap": "3.15.0" },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.1",
    "puppeteer-core": "24.39.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
