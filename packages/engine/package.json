{
  "name": "@beam/engine",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./shared/shape-vector-schema": {
      "types": "./src/shared/shape-vector-schema.d.ts",
      "default": "./src/shared/shape-vector-schema.js"
    },
    "./shared/animated-frame-schema": {
      "types": "./src/shared/animated-frame-schema.d.ts",
      "default": "./src/shared/animated-frame-schema.js"
    },
    "./capture/cursor-click-schema": {
      "types": "./src/capture/cursor-click-schema.d.ts",
      "default": "./src/capture/cursor-click-schema.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "svg-pathdata": "9.0.0"
  }
}
