{
  "name": "demo-recorder",
  "private": true,
  "version": "0.1.0",
  "description": "Beam — screen, webcam and audio recorder with a visual editor.",
  "author": "ExtraBinoss",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "test:coverage": "vitest run --coverage",
    "rust-test": "powershell.exe -NoProfile -Command \"cargo test --workspace --all-features\"",
    "rust-test:coverage": "powershell.exe -NoProfile -Command \"cargo llvm-cov --workspace --all-features --html --output-dir coverage/rust; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cargo llvm-cov report --text --show-missing-lines; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cargo llvm-cov report --lcov --output-path coverage/rust/lcov.info\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "typecheck:vue": "vue-tsc -b --pretty false",
    "dev": "vite",
    "dev:all": "node start-dev.cjs",
    "dev:all:devtools": "node start-dev.cjs --devtools",
    "capture:build-dev": "cargo build -p capture --bin capture-engine",
    "capture:build-release": "cargo build -p capture --bin capture-engine --release",
    "build:dev": "npm run capture:build-dev && vite build --mode development",
    "build:release": "npm run capture:build-release && vite build",
    "build": "npm run build:release",
    "preview": "vite preview",
    "electron:dev": "npm run capture:build-dev && electron .",
    "electron:dev-norust": "node scripts/electron-dev-norust.cjs",
    "electron:build": "npm run build:release && electron-builder --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lucide/vue": "^1.25.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/electron": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "electron-updater": "^6.6.2",
    "mediabunny": "^1.50.9",
    "pinia": "^4.0.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.beam.app",
    "productName": "Beam",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "target/release",
        "to": "capture-engine",
        "filter": [
          "capture-engine",
          "capture-engine.exe"
        ]
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ExtraBinoss",
        "repo": "demo-recorder"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/brand/BeamIcon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
