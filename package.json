{
  "name": "demo-recorder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "dev": "vite",
    "dev:all": "node start-dev.cjs",
    "capture:build-dev": "cargo build -p capture --bin capture-engine",
    "capture:build-release": "cargo build -p capture --bin capture-engine --release",
    "build:dev": "npm run capture:build-dev && vue-tsc -b && vite build --mode development",
    "build:release": "npm run capture:build-release && vue-tsc -b && vite build",
    "build": "npm run build:release",
    "preview": "vite preview",
    "electron:dev": "npm run capture:build-dev && electron .",
    "electron:build": "npm run build:release && electron-builder"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/electron": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "pinia": "^4.0.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  },
  "build": {
    "appId": "com.demorecorder.app",
    "productName": "DemoRecorder",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs"
    ],
    "extraResources": [
      {
        "from": "target/release",
        "to": "capture-engine",
        "filter": [
          "capture-engine",
          "capture-engine.exe"
        ]
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis"
    }
  }
}
