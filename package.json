{
  "name": "demo-recorder",
  "private": true,
  "version": "0.0.0",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  },
  "build": {
    "appId": "com.demorecorder.app",
    "productName": "DemoRecorder",
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis"
    }
  }
}
